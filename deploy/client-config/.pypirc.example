# ============================================================
# ~/.pypirc  (or copy to project root as .pypirc)
#
# Credentials for uploading packages with twine.
# Replace placeholders with real values.
# NEVER commit this file — it contains credentials.
# ============================================================

[distutils]
index-servers =
    pypi-private

[pypi-private]
repository = https://pypi.yourdomain.com
username   = YOUR_USERNAME
password   = YOUR_PASSWORD

# ============================================================
# pip.conf — configure pip to use your private registry
#
# Linux/macOS:   ~/.config/pip/pip.conf  (user-wide)
#                OR $VIRTUAL_ENV/pip.conf  (venv-only)
# Windows:       %APPDATA%\pip\pip.ini
#
# For CI/CD, set environment variables instead:
#   PIP_INDEX_URL=https://user:password@pypi.yourdomain.com/simple/
# ============================================================

[global]
index-url = https://YOUR_USERNAME:YOUR_PASSWORD@pypi.yourdomain.com/simple/

# Optional: also search PyPI for packages not in your private index
# extra-index-url = https://pypi.org/simple/
